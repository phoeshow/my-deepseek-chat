# 依赖
node_modules/

# 构建产物
out/
dist/
release/
build/Release/

# 原生模块（由 electron-rebuild 生成，不入库）
*.node

# 环境与密钥（项目本身把 Key 存在 userData，这里只是防止误提交）
.env
.env.*
!/.env.example

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 临时数据（若开发时把 userData 指到项目内）
.data/
*.db
*.db-wal
*.db-shm
!fixtures/*.db
