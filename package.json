{
  "name": "my-deepseek-chat",
  "version": "1.0.0",
  "description": "本地运行的 DeepSeek 桌面聊天助手",
  "main": "./out/main/index.js",
  "author": "phoeshow",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "smoke": "esbuild scripts/smoke-chat.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --alias:@main=./src/main --external:better-sqlite3 --external:electron --outfile=out/smoke/smoke-chat.cjs --log-level=warning && electron out/smoke/smoke-chat.cjs",
    "e2e:ui": "bash scripts/run-e2e-ui.sh",
    "mock": "node scripts/mock-deepseek.mjs",
    "test:migrations": "esbuild scripts/test-migrations.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --alias:@main=./src/main --external:better-sqlite3 --external:electron --outfile=out/smoke/test-migrations.cjs --log-level=warning && electron out/smoke/test-migrations.cjs",
    "dist": "pnpm build && electron-builder --linux AppImage",
    "dist:dir": "pnpm build && electron-builder --dir"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.28",
    "better-sqlite3": "^13.2.0",
    "electron-log": "^5.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
